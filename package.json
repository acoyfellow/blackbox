{
  "name": "blackbox",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "verify": "bun run check && bun run lint && bun run test",
    "samples": "bun scripts/make-samples.ts",
    "deploy": "vite build && wrangler deploy -c core/wrangler.jsonc && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
