{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-17",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.jsonl"], "fallthrough": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blackbox",
      "database_id": "89124f6e-1a97-4cba-a7a6-b2556b4a96ef"
    }
  ],
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "blackbox-logs" }],
  "observability": { "enabled": true }
}
